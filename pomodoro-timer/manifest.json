{
  "manifest_version": 3,
  "name": "Pomodoro Timer",
  "version": "1.3",
  "description": "作業と休憩を交互に計るポモドーロタイマー。独立ウインドウのウィジェットとしても使えます。",
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
